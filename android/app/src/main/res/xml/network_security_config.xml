<?xml version="1.0" encoding="utf-8"?>
<!-- 백엔드(게이트웨이 8000)는 사설 PKI의 HTTPS다(babycat analysis-reply.md §13.2:
     제조사 Root CA → 기기별 Device CA → 서버 인증서). 신뢰 경로는 두 가지다.
     - 동봉(@raw/babycat_ca): 제조사 Root CA 인증서. 이 Root CA에서 발급된
       Device CA를 가진 펫하우스는 기기 수가 늘어도 폰 쪽 설정이 없다.
       Root CA를 재생성하면 이 파일도 교체한다.
     - 사용자 설치(user): 자체 CA로 기동 중인 개발 보드는 그 보드의 CA 인증서를
       안드로이드 설정(CA 인증서 설치)으로 등록하면 접속된다.
     앱 셸 origin이 https://localhost로 전환되어(capacitor.config.json
     androidScheme) 평문 통신은 어디에도 남지 않으므로 cleartext를 금지한다. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/babycat_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
