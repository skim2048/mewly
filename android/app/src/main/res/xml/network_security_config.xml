<?xml version="1.0" encoding="utf-8"?>
<!-- 백엔드(게이트웨이 8000)는 사설 CA의 HTTPS다. 신뢰 경로는 두 가지다.
     - 동봉(@raw/babycat_ca): 보호자 CA. 이 CA로 발급받은 펫하우스들은 기기
       수가 늘어도 폰 쪽 설정이 없다. CA를 재발급하면 이 파일도 교체한다.
     - 사용자 설치(user): 다른 CA의 babycat 인스턴스는 그 CA 루트를 안드로이드
       설정(CA 인증서 설치)으로 등록하면 접속된다.
     cleartext 허용은 앱 셸 origin(http://localhost)을 위한 것으로, 백엔드
     트래픽은 전부 HTTPS다. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/babycat_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
