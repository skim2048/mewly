# Mewly — environment variable template
# Usage: cp .env.example .env && set HOST_IP to the externally reachable host IP.

# The host running babycat/mewly, reachable from your browser or Android device.
HOST_IP=192.168.0.10

# Vite development defaults. Runtime values saved from the login page override these.
VITE_BABYCAT_HOST=192.168.0.10
VITE_BABYCAT_API_URL=http://192.168.0.10:8000
VITE_BABYCAT_APP_URL=http://192.168.0.10:8080
VITE_BABYCAT_HLS_URL=http://192.168.0.10:8888/live/index.m3u8
VITE_BABYCAT_WHEP_URL=http://192.168.0.10:8889/live/whep

# Vite dev server port exposed by Docker Compose.
MEWLY_WEB_PORT=5177
